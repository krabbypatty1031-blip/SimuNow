{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "datasetVersion": {
      "const": 1
    },
    "owner": {
      "const": "com.simunow.measurements"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "projectID": {
      "type": "string",
      "format": "uuid"
    },
    "sourceSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coordinateSystem": {
      "const": "rightHandedZUp"
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
          },
          "position": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "enum": [
              "airSpeed",
              "outletSpeed",
              "outletFlow",
              "temperature",
              "electricalPower",
              "relativeHumidity",
              "co2"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "enum": [
              "m/s",
              "m3/s",
              "degC",
              "W",
              "%",
              "ppm"
            ]
          },
          "instrument": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "instrumentRange": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "instrumentCalibration": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "quality": {
            "enum": [
              "valid",
              "suspect",
              "missing",
              "rejected"
            ]
          },
          "qualityReason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "fanSetting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "doorState": {
            "enum": [
              "open",
              "closed",
              "unknown"
            ]
          },
          "windowState": {
            "enum": [
              "open",
              "closed",
              "unknown"
            ]
          },
          "partition": {
            "enum": [
              "calibration",
              "validation",
              "unassigned"
            ]
          },
          "deviceID": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "timestamp",
          "quantity",
          "unit",
          "instrument",
          "quality",
          "fanSetting",
          "doorState",
          "windowState",
          "partition"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "airSpeed"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "m/s"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "outletSpeed"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "m/s"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "outletFlow"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "m3/s"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "temperature"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "degC"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -273.15
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "electricalPower"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "W"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "relativeHumidity"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "%"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quantity": {
                  "const": "co2"
                }
              },
              "required": [
                "quantity"
              ]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "ppm"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 1
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "row",
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "datasetVersion",
    "owner",
    "id",
    "projectID",
    "sourceSHA256",
    "coordinateSystem",
    "records",
    "issues"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simunow.local/schemas/measurement-dataset.schema.json"
}
