{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "calibrationVersion": {
      "const": 1
    },
    "method": {
      "const": "simunow.experimental.finiteJet.v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "projectID": {
      "type": "string",
      "format": "uuid"
    },
    "datasetID": {
      "type": "string",
      "format": "uuid"
    },
    "deviceID": {
      "type": "string",
      "format": "uuid"
    },
    "datasetSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometrySHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "outletSpeedMetersPerSecond": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "outletRadiusMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "spreadingRate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "decayRatePerMeter": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximumDistanceMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minimumDistanceMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximumRadialDistanceMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximumValidationRMSE": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fanSetting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "calibrationIDs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 2000,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "validationIDs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 2000,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "calibrationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "meanAbsoluteErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "rootMeanSquaredErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "maximumAbsoluteErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "sampleCount",
        "meanAbsoluteErrorMetersPerSecond",
        "rootMeanSquaredErrorMetersPerSecond",
        "maximumAbsoluteErrorMetersPerSecond"
      ]
    },
    "validationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "meanAbsoluteErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "rootMeanSquaredErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "maximumAbsoluteErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "sampleCount",
        "meanAbsoluteErrorMetersPerSecond",
        "rootMeanSquaredErrorMetersPerSecond",
        "maximumAbsoluteErrorMetersPerSecond"
      ]
    },
    "uncalibratedValidationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "meanAbsoluteErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "rootMeanSquaredErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "maximumAbsoluteErrorMetersPerSecond": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "sampleCount",
        "meanAbsoluteErrorMetersPerSecond",
        "rootMeanSquaredErrorMetersPerSecond",
        "maximumAbsoluteErrorMetersPerSecond"
      ]
    },
    "acceptedForScopedResearch": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "required": [
    "calibrationVersion",
    "method",
    "id",
    "projectID",
    "datasetID",
    "deviceID",
    "datasetSHA256",
    "geometrySHA256",
    "origin",
    "direction",
    "outletSpeedMetersPerSecond",
    "outletRadiusMeters",
    "spreadingRate",
    "decayRatePerMeter",
    "maximumDistanceMeters",
    "minimumDistanceMeters",
    "maximumRadialDistanceMeters",
    "maximumValidationRMSE",
    "fanSetting",
    "calibrationIDs",
    "validationIDs",
    "calibrationMetrics",
    "validationMetrics",
    "uncalibratedValidationMetrics",
    "acceptedForScopedResearch",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simunow.local/schemas/jet-calibration.schema.json"
}
