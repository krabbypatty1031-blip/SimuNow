{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simunow:p0:simulation-request:1",
  "title": "simulation-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "fidelity"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runID",
        "scenarioID",
        "inputHash"
      ],
      "properties": {
        "runID": {
          "type": "string",
          "format": "uuid"
        },
        "scenarioID": {
          "type": "string",
          "format": "uuid"
        },
        "inputHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fidelity": {
      "enum": [
        "l0",
        "l1",
        "l2",
        "l3"
      ]
    }
  }
}
