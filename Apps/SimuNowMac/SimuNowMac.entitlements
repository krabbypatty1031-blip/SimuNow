<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outbound HTTPS for DeepSeek report generation (ADR-019). Does not
         disable the file sandbox or library validation. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Library validation stays on in Release. Loading NREL EnergyPlus
         dylibs is a Debug / signed-helper concern (ADR-011), not a product
         default. Do not copy SimuNowMacDebug.entitlements here. -->
</dict>
</plist>
