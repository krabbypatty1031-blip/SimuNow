{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simunow:p5:report-evidence:1",
  "title": "report-evidence",
  "description": "Frozen L1/L2 numbers for a report, including report-layer yearly totals copied from the representative day. Narration must not add figures that are absent here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidates", "pairDiff", "tariffReference", "comfortAssumptions"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "tariffReference": { "type": "string", "minLength": 1 },
    "comfortAssumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "runID", "scenarioID", "inputHash", "quality", "seatBandLowC", "seatBandHighC", "seatPassRatioOmitted"],
        "properties": {
          "name": { "type": "string" },
          "runID": { "type": "string", "format": "uuid" },
          "scenarioID": { "type": "string", "format": "uuid" },
          "inputHash": { "type": "string", "minLength": 1 },
          "quality": { "enum": ["notEvaluated", "passed", "failed"] },
          "l1RunID": { "type": "string", "format": "uuid" },
          "seatBandLowC": { "type": "number" },
          "seatBandHighC": { "type": "number" },
          "seatPassRatio": { "type": ["number", "null"] },
          "seatPassRatioOmitted": { "type": "boolean" },
          "seatTMinC": { "type": ["number", "null"] },
          "dayEnergyKWh": { "type": ["number", "null"] },
          "dayCost": { "type": ["number", "null"] },
          "currency": { "type": "string" },
          "supplyZ0M": { "type": "number" },
          "supplyZ1M": { "type": "number" },
          "windowCount": { "type": ["integer", "null"], "minimum": 0 },
          "windowAreaM2": { "type": ["number", "null"] },
          "roomLengthM": { "type": ["number", "null"] },
          "roomWidthM": { "type": ["number", "null"] },
          "roomHeightM": { "type": ["number", "null"] },
          "occupantCount": { "type": ["number", "null"] },
          "setpointC": { "type": ["number", "null"] },
          "supplyTemperatureC": { "type": ["number", "null"] },
          "cop": { "type": ["number", "null"] },
          "coolingW": { "type": ["number", "null"] },
          "electricPowerW": { "type": ["number", "null"] },
          "occupiedHours": { "type": ["number", "null"] },
          "occupiedDaysPerYear": { "type": ["number", "null"] },
          "indoorMeanC": { "type": ["number", "null"] },
          "indoorMinC": { "type": ["number", "null"] },
          "indoorMaxC": { "type": ["number", "null"] },
          "sliceZM": { "type": ["number", "null"] },
          "flowMinMps": { "type": ["number", "null"] },
          "flowMaxMps": { "type": ["number", "null"] },
          "seatTMaxC": { "type": ["number", "null"] },
          "seatSpeedMaxMps": { "type": ["number", "null"] },
          "annualEnergyKWh": { "type": ["number", "null"] },
          "annualCost": { "type": ["number", "null"] },
          "pricePerKWh": { "type": ["number", "null"] }
        }
      }
    },
    "pairDiff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["firstName", "secondName", "inputChanges", "resultDeltas"],
      "properties": {
        "firstName": { "type": "string" },
        "secondName": { "type": "string" },
        "basisMismatchReason": { "type": ["string", "null"] },
        "inputChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "label", "unit", "sentence"],
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "fromValue": { "type": ["number", "null"] },
              "toValue": { "type": ["number", "null"] },
              "unit": { "type": "string" },
              "sentence": { "type": "string" }
            }
          }
        },
        "resultDeltas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "field", "label", "unit"],
            "properties": {
              "dimension": { "enum": ["energy", "comfort", "flow"] },
              "field": { "type": "string" },
              "label": { "type": "string" },
              "first": { "type": ["number", "null"] },
              "second": { "type": ["number", "null"] },
              "delta": { "type": ["number", "null"] },
              "unit": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
