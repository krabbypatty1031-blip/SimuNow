{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simunow:p3:simulation-result:1",
  "title": "simulation-result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "state", "quality", "metrics"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runID", "scenarioID", "inputHash"],
      "properties": {
        "runID": { "type": "string", "format": "uuid" },
        "scenarioID": { "type": "string", "format": "uuid" },
        "inputHash": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "enum": [
        "queued", "validating", "meshing", "solving", "postprocessing", "checking",
        "succeeded", "failed", "cancelled"
      ]
    },
    "quality": { "enum": ["notEvaluated", "passed", "failed"] },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {
        "kind": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "weatherPath": { "type": "string" },
    "weatherHash": { "type": "string" },
    "supplyTemperatureC": { "type": "number" },
    "setpointC": { "type": "number" },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {
        "kind": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "hvacSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {
        "kind": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "scheduleHash": { "type": "string" },
    "qualityDetail": {
      "type": "object",
      "additionalProperties": false,
      "description": "L2 gate evidence. Optional fields: a missing or partial log is evidence of nothing.",
      "properties": {
        "checkMesh": { "type": "string" },
        "solverEnded": { "type": "boolean" },
        "monitorsStable": { "type": "boolean" },
        "massRelativeError": { "type": "number" },
        "massGate": { "type": "number" },
        "energyRelativeError": { "type": "number" },
        "energyGate": { "type": "number" }
      }
    },
    "seatSamples": {
      "type": "array",
      "description": "Present only when quality passed; a failed field omits seats instead of filling 0.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "z", "tC", "uMag"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "tC": { "type": "number" },
          "uMag": { "type": "number" },
          "lowSpeedAbsoluteError": { "type": "boolean" },
          "pmv": {
            "type": "number",
            "description": "ISO 7730 PMV at the seat; present only when comfort inputs were complete and in range."
          },
          "ppd": {
            "type": "number",
            "description": "ISO 7730 PPD [%] at the seat; present only when pmv is present."
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "method", "fidelity", "omitted"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "method": { "type": "string" },
          "fidelity": { "enum": ["l0", "l1", "l2", "l3"] },
          "omitted": { "type": "boolean" },
          "reason": {
            "type": "string",
            "description": "Why a value is omitted (missing inputs, out of model range) or how a partial aggregate was formed."
          }
        }
      }
    }
  }
}
